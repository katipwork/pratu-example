# Copy to .env to override any of the docker-compose defaults.
# The defaults are development-grade and safe to commit; these are not.

# Tenant. The hostname is {slug}.{base_domain} and must match, because Pratu
# resolves the tenant from the Host header.
PRATU_TENANT_SLUG=acme
PRATU_BASE_DOMAIN=pratu.localhost
PRATU_TENANT_HOST=acme.pratu.localhost

# Host ports.
WEB_PORT=3000
PRATU_PUBLIC_PORT=4433
PRATU_ADMIN_PORT=4434

# Secrets — 32+ characters each. Replace before exposing this to anyone.
PRATU_ADMIN_ROOT_KEY=devroot
PRATU_ENCRYPTION_KEYS=dev-encryption-key-that-is-32-chars-long!!
PRATU_OAUTH2_SYSTEM_SECRET=dev-oauth2-system-secret-32-chars-min!!
